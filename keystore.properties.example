# Copy this file to `keystore.properties` (in the project root) and fill in
# the values to build a signed release APK locally.
#
# The keystore itself (`saatiril-release.keystore`) must also be in the
# project root. It is NOT committed to git (.gitignore excludes *.keystore).
#
# In CI, this file is generated by the workflow from GitHub Actions secrets
# (SAATIRIL_KEYSTORE_BASE64, SAATIRIL_KEYSTORE_PASSWORD,
#  SAATIRIL_KEY_ALIAS, SAATIRIL_KEY_PASSWORD).

storeFile=saatiril-release.keystore
storePassword=saatiril2026
keyAlias=saatiril-andro
keyPassword=saatiril2026
