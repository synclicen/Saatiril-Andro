{
  "name": "saatiril-operator-electron",
  "version": "1.0.0",
  "description": "Saatiril Operator \u2014 Electron client app (renders React OperatorPanel, native camera + WASM)",
  "main": "operator-main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --config package-operator.json"
  },
  "author": "Saatiril",
  "license": "MIT",
  "build": {
    "appId": "com.saatiril.operator.electron",
    "productName": "Saatiril Operator",
    "directories": {
      "output": "dist-operator"
    },
    "asar": true,
    "files": [
      "operator-main.js",
      "preload.js",
      "connection.html",
      "package.json"
    ],
    "win": {
      "icon": "../../public/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "saatiril-operator-electron.exe"
    },
    "electronVersion": "28.3.3",
    "publish": null
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.6.4",
    "typescript": "^5.3.0",
    "@types/node": "20.11.0"
  },
  "repository": "https://github.com/synclicen/Saatiril-Andro.git"
}